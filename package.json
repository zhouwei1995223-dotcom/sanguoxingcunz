{
  "name": "sanguo-xingcun",
  "version": "1.0.8",
  "private": true,
  "description": "一骑当千：三国幸存者 —— 微信/抖音小游戏",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --watch",
    "audio": "node tools/gen-audio.mjs",
    "typecheck": "tsc --noEmit",
    "sim": "node tools/build.mjs --sim && node dist/sim/sim.js",
    "towersim": "esbuild tools/towersim.ts --bundle --platform=node --outfile=dist/sim/tower.js && node dist/sim/tower.js",
    "towercal": "esbuild tools/towercal.ts --bundle --platform=node --outfile=dist/sim/towercal.js --log-level=warning && node dist/sim/towercal.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
